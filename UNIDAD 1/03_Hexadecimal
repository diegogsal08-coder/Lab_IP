numero=30
if numero==0:
    print("0")
Hexadecimal=""
while numero>0:
    residuo=numero%16
    if residuo==10:
            Hexadecimal="A"+Hexadecimal
    elif residuo==11:
            Hexadecimal="B"+Hexadecimal
    elif residuo==12:
            Hexadecimal="C"+Hexadecimal
    elif residuo==13:
            Hexadecimal="D"+Hexadecimal
    elif residuo==14:
            Hexadecimal="E"+Hexadecimal
    elif residuo==15:
            Hexadecimal="F"+Hexadecimal
    else:Hexadecimal= str(residuo)+Hexadecimal
    numero=numero//16
print(Hexadecimal)