numero=8 #asignar un valor a la variable
if numero==0: print("0") #si el numero es 0, imprimir 0
binario="" #crear una variable vacia para almacenar el resultado
while numero>0: #mientras el numero sea mayor que 0, hacer lo siguiente
    binario= str(numero%2)+binario #obtener el residuo de la division entre 2 y concatenarlo al resultado
    numero=numero//2 #dividir el numero entre 2 y asignarlo a la variable
print(binario) # imprimir el resultado

numero, binario = 8, ""
if numero==0: print("0") 
while numero>0: binario, numero = str(numero%2)+binario, numero//2 
print(binario)